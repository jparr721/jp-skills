{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "types": [
      "bun"
    ],
    "noEmit": true
  },
  "include": [
    "index.ts",
    "v7.ts",
    "runtime-host.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "install.ts"
  ]
}
